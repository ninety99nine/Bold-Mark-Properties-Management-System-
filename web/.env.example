VITE_APP_NAME="BoldMark PMS"
VITE_API_URL=http://localhost:8000
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=eu

# Minutes of inactivity before the user is auto-logged-out client-side.
# Keep in sync with the API's SESSION_INACTIVITY_TIMEOUT.
VITE_SESSION_INACTIVITY_MINUTES=30

# While the user is actively interacting, ping /auth/heartbeat at most once per
# this many minutes to keep the server-side session alive. Must be comfortably
# below VITE_SESSION_INACTIVITY_MINUTES.
VITE_SESSION_HEARTBEAT_MINUTES=5
