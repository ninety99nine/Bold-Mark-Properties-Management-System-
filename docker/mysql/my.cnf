[mysqld]
# Character set — use utf8mb4 everywhere for full Unicode support (emoji, etc.)
character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci

# Authentication — use native password for broader client compatibility
default-authentication-plugin = mysql_native_password

# InnoDB buffer pool — set to ~50-70% of available RAM
# Adjust based on EC2 instance size (512M suits t3.medium and above)
innodb_buffer_pool_size = 512M
innodb_log_file_size    = 128M
innodb_flush_log_at_trx_commit = 1  # ACID compliance (safe)
innodb_flush_method     = O_DIRECT

# Connections
max_connections         = 200
wait_timeout            = 600
interactive_timeout     = 600

# Query cache (disabled in MySQL 8 — it's removed)
# query_cache_type = 0

# Slow query log — helps identify performance bottlenecks
slow_query_log         = 1
slow_query_log_file    = /var/log/mysql/slow.log
long_query_time        = 2
log_queries_not_using_indexes = 0

# Timezone
default-time-zone = '+02:00'

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
