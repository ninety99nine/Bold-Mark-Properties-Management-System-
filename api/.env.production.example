APP_NAME="BoldMark PMS"
APP_ENV=production
APP_KEY=base64:***REMOVED***=
APP_DEBUG=false
APP_URL=https://portal.boldmarkprop.co.za
FRONTEND_URL=https://portal.boldmarkprop.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database — MySQL in Docker ─────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=boldmark
DB_USERNAME=boldmark
DB_PASSWORD=***REMOVED***
DB_ROOT_PASSWORD=***REMOVED***

# ── Session ────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

# ── Services ───────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=***REMOVED***

# ── Resend — Transactional Email ──────────────────────────────────
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@boldmarkprop.co.za"
MAIL_FROM_NAME="BoldMark PMS"
RESEND_API_KEY=***REMOVED***
RESEND_WEBHOOK_SECRET=***REMOVED***

# ── Pusher — not needed for demo (broadcasts go to log) ───────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=eu

# ── AWS — not used for demo (local file storage) ──────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Horizon ───────────────────────────────────────────────────────
HORIZON_NAME="BoldMark Horizon"
