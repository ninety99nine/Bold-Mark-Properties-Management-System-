# ═══════════════════════════════════════════════════════════════════
# BoldMark PMS — Production Environment Template
# ═══════════════════════════════════════════════════════════════════
# This file is the template for the PRODUCTION_ENV GitHub secret.
#
# To prepare the secret:
#   1. Copy this file content into a text editor
#   2. Fill in every value marked CHANGE_ME
#   3. Generate APP_KEY:
#        php artisan key:generate --show
#   4. Paste the entire filled-in content as the PRODUCTION_ENV secret
#      in GitHub → Settings → Secrets and variables → Actions
# ═══════════════════════════════════════════════════════════════════

APP_NAME="BoldMark PMS"
APP_ENV=production
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_URL=https://portal.boldmarkprop.co.za
FRONTEND_URL=https://portal.boldmarkprop.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database — MySQL in Docker ─────────────────────────────────────
# DB_HOST MUST be "db" (the Docker Compose service name, not 127.0.0.1)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=boldmark
DB_USERNAME=boldmark
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# ── Session ────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.boldmarkprop.co.za

# ── Services ───────────────────────────────────────────────────────
BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ── Redis — Queue, Cache, Sessions ────────────────────────────────
# REDIS_HOST MUST be "redis" (the Docker Compose service name)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ── Pusher — Real-time ────────────────────────────────────────────
# Create a free app at https://pusher.com → Channels
PUSHER_APP_ID=CHANGE_ME
PUSHER_APP_KEY=CHANGE_ME
PUSHER_APP_SECRET=CHANGE_ME
PUSHER_APP_CLUSTER=eu
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── AWS — S3 File Storage + ECR ───────────────────────────────────
# Use the boldmark-deployer IAM credentials (from aws-bootstrap.sh output)
# S3 bucket name: boldmark-uploads-{ACCOUNT_ID} (bootstrap created this)
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=CHANGE_ME
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Resend — Transactional Email ──────────────────────────────────
RESEND_API_KEY=CHANGE_ME
RESEND_WEBHOOK_SECRET=CHANGE_ME
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@boldmarkprop.co.za"
MAIL_FROM_NAME="BoldMark PMS"

# ── Horizon ───────────────────────────────────────────────────────
HORIZON_NAME="BoldMark Horizon"
