# ════════════════════════════════════════════════════════════════════
# Production environment TEMPLATE — placeholders only, no real secrets.
#
# The real production values live in:
#   • api/.env.production            (local, git-ignored — never committed)
#   • GitHub Actions secret PRODUCTION_ENV (used by the deploy pipeline)
#
# Fill the blank values below from a secure source before deploying.
# ════════════════════════════════════════════════════════════════════

APP_NAME="BoldMark PMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://portal.boldmarkprop.co.za
FRONTEND_URL=https://portal.boldmarkprop.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database — MySQL in Docker ─────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=boldmark
DB_USERNAME=boldmark
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── Session ────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

# Minutes of inactivity before an API session (access token) is auto-revoked.
# "Remember me" sessions are exempt. Keep the frontend's
# VITE_SESSION_INACTIVITY_MINUTES in sync with this value.
SESSION_INACTIVITY_TIMEOUT=30

# ── Services ───────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Resend — Transactional Email ──────────────────────────────────
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@boldmarkprop.co.za"
MAIL_FROM_NAME="BoldMark PMS"
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ── Pusher — not needed for demo (broadcasts go to log) ───────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=eu

# Minutes of inactivity before the user is auto-logged-out client-side.
# Keep in sync with SESSION_INACTIVITY_TIMEOUT above. NOTE: Vite vars are
# baked in at build time — for the DigitalOcean build this is set in the
# frontend build step of .github/workflows/ci-cd.yml, not read from here.
VITE_SESSION_INACTIVITY_MINUTES=30

# ── AWS — not used for demo (local file storage) ──────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Horizon ───────────────────────────────────────────────────────
HORIZON_NAME="BoldMark Horizon"
