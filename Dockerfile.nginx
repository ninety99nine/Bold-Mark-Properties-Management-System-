# ═══════════════════════════════════════════════════════════
# Stage 1: Build Vue 3 Frontend
# ═══════════════════════════════════════════════════════════
FROM node:20-alpine AS frontend-builder
WORKDIR /app

COPY web/package*.json ./
RUN npm ci --ignore-scripts

COPY web/ ./

ARG VITE_API_URL=
ARG VITE_APP_NAME="BoldMark PMS"
ARG VITE_PUSHER_APP_KEY
ARG VITE_PUSHER_APP_CLUSTER=eu
# Minutes of inactivity before the user is auto-logged-out client-side.
# Keep in sync with the API's SESSION_INACTIVITY_TIMEOUT.
ARG VITE_SESSION_INACTIVITY_MINUTES=120

ENV VITE_API_URL=$VITE_API_URL \
    VITE_APP_NAME=$VITE_APP_NAME \
    VITE_PUSHER_APP_KEY=$VITE_PUSHER_APP_KEY \
    VITE_PUSHER_APP_CLUSTER=$VITE_PUSHER_APP_CLUSTER \
    VITE_SESSION_INACTIVITY_MINUTES=$VITE_SESSION_INACTIVITY_MINUTES

RUN npm run build

# ═══════════════════════════════════════════════════════════
# Stage 2: Nginx with Vue static files baked in
# ═══════════════════════════════════════════════════════════
FROM nginx:1.25-alpine

RUN apk add --no-cache openssl

COPY --from=frontend-builder /app/dist /var/www/html/public-web

COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf
COPY nginx/ssl_params.conf /etc/nginx/ssl_params.conf
COPY nginx/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80 443

HEALTHCHECK --interval=5s --timeout=3s --retries=3 \
    CMD wget -qO- http://localhost/up 2>/dev/null | grep -q '"status"' || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
